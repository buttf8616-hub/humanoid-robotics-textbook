# Book Ingestion Pipeline Environment Variables

# Base URL of the deployed Docusaurus book
BOOK_BASE_URL="https://your-site.vercel.app"

# Cohere API credentials
COHERE_API_KEY="your-cohere-api-key-here"

# Qdrant Cloud credentials
QDRANT_URL="https://your-qdrant-url.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key-here"
QDRANT_COLLECTION_NAME="embedding-book"

# Gemini API credentials (for AI Agent)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=2000

# Groq API credentials
GROQ_API_KEY="your-groq-api-key-here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=2000

# Anthropic API credentials
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
